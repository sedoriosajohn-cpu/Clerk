# ============================================================
# Clerk — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- AI (Required for smart extraction) ---
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model to use for task extraction (default: gpt-5.4)
# OPENAI_MODEL=gpt-5.4

# --- Google OAuth (Required for Gmail / Calendar / Classroom sync) ---
# Paste the contents of your credentials.json here as a single JSON string,
# OR place credentials.json at Clerk/credentials.json (local dev only).
# GOOGLE_CREDENTIALS_JSON={"web":{"client_id":"...","client_secret":"...",...}}

# OAuth redirect URI — must match exactly what you registered in Google Cloud Console.
# Local default: http://localhost:8000/auth/google/callback
# GOOGLE_REDIRECT_URI=https://yourapp.onrender.com/auth/google/callback

# Frontend URL used in redirect links (password reset, OAuth success).
# Local default: http://127.0.0.1:8000
# CLERK_FRONTEND_URL=https://yourapp.onrender.com

# --- Database ---
# SQLite is used automatically when DATABASE_URL is not set (local dev).
# For production use a PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/clerk

# --- Email / SMTP (Required for 2FA and password-reset emails) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password   # Gmail: generate at myaccount.google.com/apppasswords
# SMTP_FROM=you@gmail.com

# --- Security ---
# Comma-separated list of allowed CORS origins.
# Defaults to "*" (all origins) when not set — tighten this in production.
# CORS_ALLOWED_ORIGINS=https://yourapp.onrender.com,https://www.yourapp.com

# --- Auto-sync tuning (optional) ---
# AUTO_SYNC_ENABLED=1
# AUTO_SYNC_INTERVAL_SECONDS=900
# SYNC_THROTTLE_SECONDS=30

# How many days back Google sync looks (Classroom, Gmail, Google Tasks, Calendar).
# Older items are skipped and previously imported stale ones are moved to History.
# GOOGLE_SYNC_PAST_DAYS=14
